{
  "schema_version": 1,
  "id": "verein_conversation_workflow",
  "version": "1.1.0",
  "domain_id": "verein-demo",
  "domain_version": "1.0.0",
  "tags": [
    "deterministic",
    "verein",
    "advisory",
    "workflow"
  ],
  "data_classification": "synthetic",
  "persist_raw": true,
  "steps": [
    {
      "id": "start",
      "action": "start_assessment",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "in_progress"
        }
      ]
    },
    {
      "id": "too_early",
      "action": "create_conversation",
      "expected_ok": false,
      "assertions": [
        {
          "path": "/errors",
          "op": "contains",
          "expected": {
            "code": "profile_not_found"
          }
        }
      ]
    },
    {
      "id": "club_type",
      "action": "submit_answer",
      "payload": {
        "question_id": "club_type",
        "value": "sports"
      },
      "assertions": []
    },
    {
      "id": "founded_year",
      "action": "submit_answer",
      "payload": {
        "question_id": "founded_year",
        "value": 1980
      },
      "assertions": []
    },
    {
      "id": "members_count",
      "action": "submit_answer",
      "payload": {
        "question_id": "members_count",
        "value": 120
      },
      "assertions": []
    },
    {
      "id": "funding_source",
      "action": "submit_answer",
      "payload": {
        "question_id": "funding_source",
        "value": "public_grants"
      },
      "assertions": []
    },
    {
      "id": "volunteer_situation",
      "action": "submit_answer",
      "payload": {
        "question_id": "volunteer_situation",
        "value": "tight"
      },
      "assertions": []
    },
    {
      "id": "annual_budget_eur",
      "action": "submit_answer",
      "payload": {
        "question_id": "annual_budget_eur",
        "value": null
      },
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "review"
        }
      ]
    },
    {
      "id": "complete",
      "action": "complete",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "completed"
        },
        {
          "path": "/result/reason_codes",
          "op": "eq",
          "expected": [
            "GRANTS_DEPENDENT",
            "VOLUNTEERS_AT_RISK",
            "OLD_STATUTES",
            "MISSING_BUDGET"
          ]
        },
        {
          "path": "/result/recommendations",
          "op": "contains",
          "expected": {
            "recommendation_id": "volunteer-recruiting",
            "source": "rule"
          }
        }
      ]
    },
    {
      "id": "create",
      "action": "create_conversation",
      "payload": {
        "title": "Finanzen"
      },
      "assertions": [
        {
          "path": "/conversation/title",
          "op": "eq",
          "expected": "Finanzen"
        },
        {
          "path": "/conversation/messages",
          "op": "eq",
          "expected": []
        },
        {
          "path": "/conversation/domain_id",
          "op": "eq",
          "expected": "verein-demo"
        }
      ]
    },
    {
      "id": "get",
      "action": "get_conversation",
      "assertions": [
        {
          "path": "/conversation/title",
          "op": "eq",
          "expected": "Finanzen"
        },
        {
          "path": "/conversation/revision",
          "op": "eq",
          "expected": 1
        }
      ]
    },
    {
      "id": "list",
      "action": "list_conversations",
      "assertions": [
        {
          "path": "/conversations",
          "op": "contains",
          "expected": {
            "title": "Finanzen"
          }
        }
      ]
    },
    {
      "id": "delete",
      "action": "delete_conversation",
      "assertions": [
        {
          "path": "/ok",
          "op": "eq",
          "expected": true
        }
      ]
    },
    {
      "id": "gone",
      "action": "get_conversation",
      "expected_ok": false,
      "assertions": [
        {
          "path": "/errors",
          "op": "contains",
          "expected": {
            "code": "conversation_not_found"
          }
        }
      ]
    },
    {
      "id": "gone_delete",
      "action": "delete_conversation",
      "expected_ok": false,
      "assertions": [
        {
          "path": "/errors",
          "op": "contains",
          "expected": {
            "code": "conversation_not_found"
          }
        }
      ]
    },
    {
      "id": "session_unchanged",
      "action": "get_session",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "completed"
        },
        {
          "path": "/result/reason_codes",
          "op": "eq",
          "expected": [
            "GRANTS_DEPENDENT",
            "VOLUNTEERS_AT_RISK",
            "OLD_STATUTES",
            "MISSING_BUDGET"
          ]
        }
      ]
    }
  ],
  "assertions": []
}
