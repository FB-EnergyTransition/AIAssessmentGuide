{
  "schema_version": 1,
  "id": "verein_advisory_conversations",
  "version": "1.0.0",
  "domain_id": "verein-demo",
  "domain_version": "1.0.0",
  "tags": [
    "llm",
    "verein",
    "advisory",
    "chat"
  ],
  "data_classification": "synthetic",
  "persist_raw": true,
  "steps": [
    {
      "id": "start",
      "action": "start_assessment",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "in_progress"
        }
      ]
    },
    {
      "id": "club_type",
      "action": "submit_answer",
      "payload": {
        "question_id": "club_type",
        "value": "sports"
      },
      "assertions": []
    },
    {
      "id": "founded_year",
      "action": "submit_answer",
      "payload": {
        "question_id": "founded_year",
        "value": 1980
      },
      "assertions": []
    },
    {
      "id": "members_count",
      "action": "submit_answer",
      "payload": {
        "question_id": "members_count",
        "value": 120
      },
      "assertions": []
    },
    {
      "id": "funding_source",
      "action": "submit_answer",
      "payload": {
        "question_id": "funding_source",
        "value": "public_grants"
      },
      "assertions": []
    },
    {
      "id": "volunteer_situation",
      "action": "submit_answer",
      "payload": {
        "question_id": "volunteer_situation",
        "value": "tight"
      },
      "assertions": []
    },
    {
      "id": "annual_budget_eur",
      "action": "submit_answer",
      "payload": {
        "question_id": "annual_budget_eur",
        "value": null
      },
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "review"
        }
      ]
    },
    {
      "id": "complete",
      "action": "complete",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "completed"
        },
        {
          "path": "/result/reason_codes",
          "op": "eq",
          "expected": [
            "GRANTS_DEPENDENT",
            "VOLUNTEERS_AT_RISK",
            "OLD_STATUTES",
            "MISSING_BUDGET"
          ]
        },
        {
          "path": "/result/recommendations",
          "op": "contains",
          "expected": {
            "recommendation_id": "volunteer-recruiting",
            "source": "rule"
          }
        }
      ]
    },
    {
      "id": "create_a",
      "action": "create_conversation",
      "payload": {
        "title": "Finanzen"
      }
    },
    {
      "id": "send_a",
      "action": "send_conversation_message",
      "payload": {
        "text": "Wie können wir die Einnahmen unseres Vereins breiter aufstellen? Antworte in drei Sätzen."
      },
      "assertions": [
        {
          "path": "/conversation/messages/0/role",
          "op": "eq",
          "expected": "user"
        },
        {
          "path": "/conversation/messages/1/role",
          "op": "eq",
          "expected": "assistant"
        },
        {
          "path": "/conversation/messages/1/content",
          "op": "exists"
        },
        {
          "path": "/conversation/revision",
          "op": "eq",
          "expected": 2
        }
      ]
    },
    {
      "id": "create_b",
      "action": "create_conversation",
      "payload": {
        "title": "Förderung"
      },
      "assertions": [
        {
          "path": "/conversation/messages",
          "op": "eq",
          "expected": []
        }
      ]
    },
    {
      "id": "send_b",
      "action": "send_conversation_message",
      "payload": {
        "text": "Was weißt du über meinen Verein? Antworte in zwei Sätzen."
      },
      "assertions": [
        {
          "path": "/conversation/messages/1/role",
          "op": "eq",
          "expected": "assistant"
        },
        {
          "path": "/conversation/messages/2",
          "op": "exists",
          "expected": false
        }
      ]
    },
    {
      "id": "get_a",
      "action": "get_conversation",
      "references": {
        "conversation_id": "create_a#/conversation/conversation_id"
      },
      "assertions": [
        {
          "path": "/conversation/messages/0/content",
          "op": "eq",
          "expected": "Wie können wir die Einnahmen unseres Vereins breiter aufstellen? Antworte in drei Sätzen."
        },
        {
          "path": "/conversation/messages/2",
          "op": "exists",
          "expected": false
        }
      ]
    },
    {
      "id": "list",
      "action": "list_conversations",
      "assertions": [
        {
          "path": "/conversations",
          "op": "contains",
          "expected": {
            "title": "Finanzen"
          }
        },
        {
          "path": "/conversations",
          "op": "contains",
          "expected": {
            "title": "Förderung"
          }
        }
      ]
    },
    {
      "id": "session_unchanged",
      "action": "get_session",
      "assertions": [
        {
          "path": "/result/recommendations",
          "op": "contains",
          "expected": {
            "recommendation_id": "volunteer-recruiting",
            "source": "rule"
          }
        },
        {
          "path": "/chat_messages",
          "op": "eq",
          "expected": []
        }
      ]
    }
  ],
  "assertions": []
}
