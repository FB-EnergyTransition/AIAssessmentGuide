{
  "schema_version": 1,
  "id": "verein_llm_recommendations",
  "version": "1.1.0",
  "domain_id": "verein-demo",
  "domain_version": "1.0.0",
  "tags": [
    "llm",
    "verein",
    "recommendations"
  ],
  "data_classification": "synthetic",
  "persist_raw": true,
  "steps": [
    {
      "id": "start",
      "action": "start_assessment",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "in_progress"
        }
      ]
    },
    {
      "id": "too_early",
      "action": "llm_recommendations",
      "expected_ok": false,
      "assertions": [
        {
          "path": "/errors",
          "op": "contains",
          "expected": {
            "code": "invalid_state"
          }
        }
      ]
    },
    {
      "id": "club_type",
      "action": "submit_answer",
      "payload": {
        "question_id": "club_type",
        "value": "sports"
      },
      "assertions": []
    },
    {
      "id": "founded_year",
      "action": "submit_answer",
      "payload": {
        "question_id": "founded_year",
        "value": 1980
      },
      "assertions": []
    },
    {
      "id": "members_count",
      "action": "submit_answer",
      "payload": {
        "question_id": "members_count",
        "value": 120
      },
      "assertions": []
    },
    {
      "id": "funding_source",
      "action": "submit_answer",
      "payload": {
        "question_id": "funding_source",
        "value": "public_grants"
      },
      "assertions": []
    },
    {
      "id": "volunteer_situation",
      "action": "submit_answer",
      "payload": {
        "question_id": "volunteer_situation",
        "value": "tight"
      },
      "assertions": []
    },
    {
      "id": "annual_budget_eur",
      "action": "submit_answer",
      "payload": {
        "question_id": "annual_budget_eur",
        "value": null
      },
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "review"
        }
      ]
    },
    {
      "id": "complete",
      "action": "complete",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "completed"
        },
        {
          "path": "/result/reason_codes",
          "op": "eq",
          "expected": [
            "GRANTS_DEPENDENT",
            "VOLUNTEERS_AT_RISK",
            "OLD_STATUTES",
            "MISSING_BUDGET"
          ]
        },
        {
          "path": "/result/recommendations",
          "op": "contains",
          "expected": {
            "recommendation_id": "volunteer-recruiting",
            "source": "rule"
          }
        },
        {
          "path": "/result/knowledge_generation",
          "op": "eq",
          "expected": null
        }
      ]
    },
    {
      "id": "recs",
      "action": "llm_recommendations",
      "assertions": [
        {
          "path": "/recommendations",
          "op": "contains",
          "expected": {
            "source": "llm"
          }
        },
        {
          "path": "/recommendations/0/rationale",
          "op": "exists"
        },
        {
          "path": "/recommendations/0/evidence_fields",
          "op": "exists"
        }
      ]
    },
    {
      "id": "session_unchanged",
      "action": "get_session",
      "assertions": [
        {
          "path": "/result/recommendations",
          "op": "contains",
          "expected": {
            "source": "rule"
          }
        },
        {
          "path": "/result/recommendations/4",
          "op": "exists",
          "expected": false
        },
        {
          "path": "/result/knowledge_recommendations",
          "op": "contains",
          "expected": {
            "source": "llm"
          }
        },
        {
          "path": "/result/knowledge_generation/model",
          "op": "exists"
        },
        {
          "path": "/result/knowledge_generation/prompt_version",
          "op": "exists"
        },
        {
          "path": "/result/knowledge_generation/error_code",
          "op": "eq",
          "expected": null
        }
      ]
    }
  ],
  "assertions": []
}
