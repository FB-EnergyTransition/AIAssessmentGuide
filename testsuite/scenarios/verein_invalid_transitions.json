{
  "schema_version": 1,
  "id": "verein_invalid_transitions",
  "version": "1.0.0",
  "domain_id": "verein-demo",
  "domain_version": "1.0.0",
  "tags": [
    "deterministic",
    "verein",
    "workflow"
  ],
  "data_classification": "synthetic",
  "persist_raw": true,
  "steps": [
    {
      "id": "start",
      "action": "start_assessment",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "in_progress"
        }
      ]
    },
    {
      "id": "early_report",
      "action": "get_report",
      "assertions": [
        {
          "path": "/errors",
          "op": "contains",
          "expected": {
            "code": "invalid_state"
          }
        }
      ],
      "expected_ok": false
    },
    {
      "id": "early_complete",
      "action": "complete",
      "assertions": [
        {
          "path": "/errors",
          "op": "contains",
          "expected": {
            "code": "invalid_state"
          }
        }
      ],
      "expected_ok": false
    },
    {
      "id": "wrong_question",
      "action": "submit_answer",
      "payload": {
        "question_id": "funding_source",
        "value": "public_grants"
      },
      "assertions": [
        {
          "path": "/errors",
          "op": "contains",
          "expected": {
            "code": "invalid_question"
          }
        }
      ],
      "expected_ok": false
    },
    {
      "id": "club_type",
      "action": "submit_answer",
      "payload": {
        "question_id": "club_type",
        "value": "sports"
      },
      "assertions": []
    },
    {
      "id": "founded_year",
      "action": "submit_answer",
      "payload": {
        "question_id": "founded_year",
        "value": 1980
      },
      "assertions": []
    },
    {
      "id": "members_count",
      "action": "submit_answer",
      "payload": {
        "question_id": "members_count",
        "value": 120
      },
      "assertions": []
    },
    {
      "id": "funding_source",
      "action": "submit_answer",
      "payload": {
        "question_id": "funding_source",
        "value": "public_grants"
      },
      "assertions": []
    },
    {
      "id": "volunteer_situation",
      "action": "submit_answer",
      "payload": {
        "question_id": "volunteer_situation",
        "value": "tight"
      },
      "assertions": []
    },
    {
      "id": "annual_budget_eur",
      "action": "submit_answer",
      "payload": {
        "question_id": "annual_budget_eur",
        "value": null
      },
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "review"
        },
        {
          "path": "/progress/answered_required",
          "op": "eq",
          "expected": 5
        }
      ]
    },
    {
      "id": "complete",
      "action": "complete",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "completed"
        },
        {
          "path": "/result/reason_codes",
          "op": "eq",
          "expected": [
            "GRANTS_DEPENDENT",
            "VOLUNTEERS_AT_RISK",
            "OLD_STATUTES",
            "MISSING_BUDGET"
          ]
        }
      ]
    },
    {
      "id": "after_complete",
      "action": "submit_answer",
      "payload": {
        "question_id": "club_type",
        "value": "social"
      },
      "assertions": [
        {
          "path": "/errors",
          "op": "contains",
          "expected": {
            "code": "invalid_state"
          }
        }
      ],
      "expected_ok": false
    },
    {
      "id": "get",
      "action": "get_session",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "completed"
        }
      ]
    }
  ],
  "assertions": []
}
