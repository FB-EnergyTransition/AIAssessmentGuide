{
  "schema_version": 1,
  "id": "verein_profile_chat_feedback",
  "version": "1.1.0",
  "domain_id": "verein-demo",
  "domain_version": "1.0.0",
  "tags": [
    "llm",
    "verein",
    "profile",
    "chat",
    "feedback"
  ],
  "data_classification": "synthetic",
  "persist_raw": true,
  "assertions": [],
  "review": {
    "persona": "sportverein_skeptisch",
    "persona_label": "Sportverein von 1980, öffentlich gefördert, lehnt Vereinsberatung ab",
    "kind": "edge",
    "check": "Erkennt der Chat die Ablehnung der Vereinsberatung, fragt nach, vermerkt erst nach Ja, und wirbt die spätere Beratungsantwort nicht erneut für die Vereinsberatung?"
  },
  "steps": [
    {
      "id": "start",
      "action": "start_assessment",
      "assertions": []
    },
    {
      "id": "club_type",
      "action": "submit_answer",
      "payload": {
        "question_id": "club_type",
        "value": "sports"
      },
      "assertions": []
    },
    {
      "id": "founded_year",
      "action": "submit_answer",
      "payload": {
        "question_id": "founded_year",
        "value": 1980
      },
      "assertions": []
    },
    {
      "id": "members_count",
      "action": "submit_answer",
      "payload": {
        "question_id": "members_count",
        "value": 120
      },
      "assertions": []
    },
    {
      "id": "funding_source",
      "action": "submit_answer",
      "payload": {
        "question_id": "funding_source",
        "value": "public_grants"
      },
      "assertions": []
    },
    {
      "id": "volunteer_situation",
      "action": "submit_answer",
      "payload": {
        "question_id": "volunteer_situation",
        "value": "tight"
      },
      "assertions": []
    },
    {
      "id": "annual_budget_eur",
      "action": "submit_answer",
      "payload": {
        "question_id": "annual_budget_eur",
        "value": null
      },
      "assertions": []
    },
    {
      "id": "complete",
      "action": "complete",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "completed"
        }
      ]
    },
    {
      "id": "chat",
      "action": "create_conversation",
      "payload": {
        "title": "Rückmeldung"
      },
      "assertions": []
    },
    {
      "id": "reject",
      "action": "send_conversation_message",
      "payload": {
        "text": "Eine Vereinsberatung kommt für uns nicht in Frage, das lehnen wir ab."
      },
      "assertions": [
        {
          "path": "/conversation/messages/1/content",
          "op": "contains",
          "expected": "Vereinsberatung einholen"
        },
        {
          "path": "/conversation/messages/1/content",
          "op": "contains",
          "expected": "abgelehnt"
        },
        {
          "path": "/conversation/pending/kind",
          "op": "eq",
          "expected": "confirm_feedback"
        },
        {
          "path": "/conversation/pending/recommendation_id",
          "op": "eq",
          "expected": "club-consultation"
        }
      ]
    },
    {
      "id": "confirm",
      "action": "send_conversation_message",
      "payload": {
        "text": "ja"
      },
      "assertions": [
        {
          "path": "/conversation/messages/3/content",
          "op": "contains",
          "expected": "abgelehnt"
        },
        {
          "path": "/conversation/pending",
          "op": "eq",
          "expected": null
        }
      ]
    },
    {
      "id": "profile",
      "action": "get_profile",
      "assertions": [
        {
          "path": "/profile/feedback/club-consultation/stance",
          "op": "eq",
          "expected": "rejected"
        },
        {
          "path": "/profile/feedback/club-consultation/origin",
          "op": "eq",
          "expected": "chat"
        }
      ]
    },
    {
      "id": "advice",
      "action": "send_conversation_message",
      "payload": {
        "text": "Was sollte ich als Nächstes angehen? Antworte in drei Sätzen."
      },
      "assertions": [
        {
          "path": "/conversation/messages/5/role",
          "op": "eq",
          "expected": "assistant"
        },
        {
          "path": "/conversation/messages/5/content",
          "op": "not_contains",
          "expected": "Vereinsberatung"
        }
      ]
    }
  ]
}
