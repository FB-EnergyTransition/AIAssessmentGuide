{
  "schema_version": 1,
  "version": "1.0.0",
  "domain_id": "verein-demo",
  "domain_version": "1.0.0",
  "tags": [
    "regression",
    "llm",
    "verein",
    "interpretation"
  ],
  "data_classification": "synthetic",
  "persist_raw": true,
  "id": "regression_number_words_members",
  "steps": [
    {
      "id": "start",
      "action": "start_assessment",
      "assertions": [
        {
          "path": "/status",
          "op": "eq",
          "expected": "in_progress"
        }
      ]
    },
    {
      "id": "club_type",
      "action": "submit_answer",
      "payload": {
        "question_id": "club_type",
        "value": "sports"
      },
      "assertions": []
    },
    {
      "id": "founded_year",
      "action": "submit_answer",
      "payload": {
        "question_id": "founded_year",
        "value": 1980
      },
      "assertions": []
    },
    {
      "id": "sqm_words",
      "action": "submit_text_answer",
      "payload": {
        "question_id": "members_count",
        "text": "hundertsechzig Mitglieder laut Mitgliederliste"
      },
      "assertions": [
        {
          "path": "/accepted_answer/normalized_value",
          "op": "eq",
          "expected": 160
        },
        {
          "path": "/current_question/question_id",
          "op": "eq",
          "expected": "funding_source"
        }
      ]
    }
  ],
  "assertions": []
}
