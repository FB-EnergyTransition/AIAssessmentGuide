# Copy to .env for the Compose stack. Never commit the populated file.
GUIDEOS_POSTGRES_PASSWORD=replace-with-a-long-random-password
GUIDEOS_TEST_PASSWORD=replace-with-the-shared-pilot-password
GUIDEOS_OLLAMA_ENDPOINT=http://ollama.internal:11434
GUIDEOS_OLLAMA_MODEL=gpt-oss:20b
# Optional, nur für Testphasen: 1 zeigt Testern im Web-Client das Dropdown „KI-Modell“ mit den
# Modellen des Ollama-Endpoints; die Wahl geht als Header X-GuideOS-Model mit jeder Anfrage.
# Standard 0: Testkunden sehen keinen Modellnamen, die API nutzt GUIDEOS_OLLAMA_MODEL.
GUIDEOS_MODEL_SELECTION=0
# Optional: in Ollama geladenes Embedding-Modell für die Wissensbasis (z. B. bge-m3).
# Ohne diesen Wert sucht die Wissensbasis lexikalisch, mit ihm hybrid (BM25 plus Embeddings).
GUIDEOS_EMBEDDING_MODEL=
# Optional: Modell, das die gefundenen Abschnitte je Anfrage nachsortiert (Reranker).
# Ollama bietet keinen Cross-Encoder, daher bewertet ein Chat-Modell die Abschnitte strukturiert.
GUIDEOS_RERANK_MODEL=
# Optional: DEBUG protokolliert zusätzlich jede abgeschlossene Ollama-Anfrage mit Dauer.
GUIDEOS_LOG_LEVEL=INFO
# Optional: Aufbewahrungsfrist in Tagen für Sessions, Profile und Beratungschats.
# Leer = unbegrenzt (Standard). Der Container entfernt ältere Daten bei jedem Start,
# zusätzlich manuell: python -m guideos.pilot.retention [--apply].
GUIDEOS_RETENTION_DAYS=
# Optional: nur diese Domänen (domain_id, kommagetrennt) im Assessment anbieten; leer = alle
# aktiven Domänen. Die übrigen Packs bleiben im Image, damit gespeicherte Sessions ladbar bleiben.
GUIDEOS_DOMAINS=
# Optional: eigener Schlüssel für das Session-Cookie des API-Logins (sonst das Testpasswort)
# GUIDEOS_SESSION_SECRET=
# Hinter HTTPS: Cookie nur über HTTPS senden
# GUIDEOS_COOKIE_SECURE=1
# Zeitlimit je Modellanfrage in Sekunden (Standard 120); große Modelle brauchen mit
# Werkzeugergebnissen im Prompt für die KI-Empfehlungen beim Abschluss bis zu 300.
GUIDEOS_PROVIDER_TIMEOUT_SECONDS=300
